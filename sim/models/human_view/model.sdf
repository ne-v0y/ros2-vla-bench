<?xml version="1.0"?>
<sdf version="1.9">
  <model name="vla_human_view">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <inertial>
        <pose>0 0 0.20 0 0 0</pose>
        <mass>18.0</mass>
        <inertia><ixx>0.55</ixx><iyy>0.75</iyy><izz>0.70</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.19 0 0 0</pose>
        <geometry><box><size>0.46 0.36 0.22</size></box></geometry>
      </collision>
      <collision name="rear_caster_collision">
        <pose>-0.18 0 0.045 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.19 0 0 0</pose>
        <geometry><box><size>0.46 0.36 0.22</size></box></geometry>
        <material><ambient>0.12 0.15 0.18 1</ambient><diffuse>0.18 0.22 0.26 1</diffuse></material>
      </visual>
      <visual name="mast_visual">
        <pose>0 0 0.94 0 0 0</pose>
        <geometry><box><size>0.07 0.07 1.42</size></box></geometry>
        <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse></material>
      </visual>
      <visual name="camera_housing">
        <pose>0.075 0 1.62 0 0 0</pose>
        <geometry><box><size>0.15 0.12 0.09</size></box></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0.11 0 1.62 0 0 0</pose>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>50.0</far></clip>
        </camera>
      </sensor>
      <sensor name="navigation_lidar" type="gpu_lidar">
        <pose>0.10 0 0.95 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
          <range><min>0.08</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
      <sensor name="base_imu" type="imu">
        <pose>0 0 0.25 0 0 0</pose>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.20 0.10 1.57079633 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.20 0.10 1.57079633 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>20</velocity></limit></axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint><right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.40</wheel_separation><wheel_radius>0.10</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration><max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic><joint_name>wheel_left_joint</joint_name><joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
